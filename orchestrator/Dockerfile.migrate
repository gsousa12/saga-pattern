FROM node:20-alpine
RUN npm install -g pnpm
WORKDIR /app

COPY package.json pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/db ./packages/db

RUN pnpm install

ENV DATABASE_URL=postgresql://postgres:postgres@postgres:5432/orchestrator

CMD ["pnpm", "--filter", "@orchestrator/db", "db:migrate"]
